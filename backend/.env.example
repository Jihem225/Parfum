# Copier en .env puis adapter. Ne jamais commiter .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://localhost/parfums
FRONTEND_ORIGIN=http://localhost:3000

# Tests (pytest) : base dédiée, jamais la base de développement.
TEST_DATABASE_URL=postgresql+psycopg://localhost/parfums_test

# Secret de signature et de chiffrement (secrets TOTP). Obligatoire, unique par environnement.
# Générer : python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true en production (cookies envoyés uniquement en HTTPS)
COOKIE_SECURE=false

# E-mails (Resend). Vide en développement : les e-mails s'affichent dans la console.
RESEND_API_KEY=
EMAIL_FROM=Projet Parfums <no-reply@example.com>
SHOP_NOTIFICATION_EMAIL=

# Les autres variables (stockage S3/R2, Sentry…) seront ajoutées avec
# les fonctionnalités qui les utilisent — liste complète : docs/03-conception-technique.md §12.
