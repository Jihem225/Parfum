# Copier en .env puis adapter. Ne jamais commiter .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://localhost/parfums
FRONTEND_ORIGIN=http://localhost:3000

# Tests (pytest) : base dédiée, jamais la base de développement.
TEST_DATABASE_URL=postgresql+psycopg://localhost/parfums_test

# Les autres variables (stockage S3/R2, e-mails, Sentry…) seront ajoutées avec
# les fonctionnalités qui les utilisent — liste complète : docs/03-conception-technique.md §12.
