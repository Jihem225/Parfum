# Copier en .env puis adapter. Ne jamais commiter .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://localhost/parfums
FRONTEND_ORIGIN=http://localhost:3000

# Tests (pytest) : base dédiée, jamais la base de développement.
TEST_DATABASE_URL=postgresql+psycopg://localhost/parfums_test

# Secret de signature et de chiffrement (secrets TOTP). Obligatoire, unique par environnement.
# Générer : python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true en production (cookies envoyés uniquement en HTTPS)
COOKIE_SECURE=false

# E-mails (Resend). Vide en développement : les e-mails s'affichent dans la console.
RESEND_API_KEY=
EMAIL_FROM=Projet Parfums <no-reply@example.com>
SHOP_NOTIFICATION_EMAIL=

# Production uniquement (voir docs/09-deploiement.md) : relais devant l'API (1 = Render, 2 = + Cloudflare)
TRUSTED_PROXY_HOPS=0

# Images sur Cloudflare R2 (API S3). Vide : stockage local dans media/ (développement).
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

ORDER_NUMBER_PREFIX=PP
# Commandes par adresse IP et par heure (10 en production ; plus pour les parcours E2E)
ORDER_RATE_LIMIT=10

# Mobile money : vide = désactivé ; « simulation » = faux paiements pour le développement (refusé
# en production). Secret de signature des avis de paiement (simulation : n'importe quelle valeur).
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
